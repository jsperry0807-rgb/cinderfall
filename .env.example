# Copy to .env and adjust. The API only reads process.env; export these or run
# with `node --env-file=.env`.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# `memory://` starts a throwaway MongoDB (dev/test only).
MONGODB_URI=memory://
DB_NAME=cinderfall

# The browser origin allowed to make state-changing requests.
PUBLIC_ORIGIN=http://localhost:5173

# Session cookie. COOKIE_SECURE defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Required in production (32+ chars). Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# Set true when behind Caddy/nginx so req.ip is the client address.
TRUST_PROXY=false

LOG_LEVEL=info
GUEST_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=10
LOGIN_RATE_LIMIT=30
# Maximum offline progress simulated when a player returns (hours).
OFFLINE_CAP_HOURS=8

# Set when the API serves the built SPA (container/Caddy deployments).
# WEB_DIST=/app/apps/web/dist

# Email delivery: "console" logs links (dev), "resend" sends real mail.
MAILER=console
# MAIL_FROM="Cinderfall <no-reply@example.com>"
# RESEND_API_KEY=re_...
