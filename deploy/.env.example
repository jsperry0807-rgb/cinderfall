# Copy to deploy/.env and chmod 600.
DOMAIN=cinderfall.example.com
PUBLIC_ORIGIN=https://cinderfall.example.com

# Generate with:
#   openssl rand -hex 24   (Mongo passwords; hex keeps the URI safe)
#   openssl rand -base64 48 (SESSION_SECRET)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
MONGO_APP_USER=cinderfall
MONGO_APP_PASSWORD=replace-with-openssl-rand-hex-24

# The app entrypoint creates/updates MONGO_APP_USER on startup; compose builds the URI.

SESSION_SECRET=replace-with-openssl-rand-base64-48

MAILER=resend
RESEND_API_KEY=re_replace_me
MAIL_FROM=Cinderfall <no-reply@cinderfall.example.com>

LOG_LEVEL=info
OFFLINE_CAP_HOURS=8
